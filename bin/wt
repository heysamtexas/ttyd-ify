#!/usr/bin/env bash
# wt — dtach-based web-terminal session picker (no tmux). The server's start command.
#
#   Shown on every browser connection: a connect menu to list active sessions,
#   attach, spawn a new one, drop to a shell, or disconnect. Sessions are dtach
#   sockets in $WT_DIR (default ~/.dtach/<name>.sock) and survive the browser closing.
#
#   Direct attach: `wt <name>` jumps straight into session <name>, skipping the menu.
#   ws://host:port/ws?arg=<name> arrives here as $1 (ttyd spelled this -a/--url-arg;
#   wtd hardcodes the behaviour), so an app can open a named session directly. See
#   bin/wt-serve for how the server is launched.
#
# dtach vs a multiplexer: no status bar, no splits. The browser (xterm.js) provides
# scrollback; dtach keeps none of its own, so `-r winch` redraws on attach.
#
# No -e: the menu loop must survive a failed command rather than exit.
set -uo pipefail

DIR="${WT_DIR:-$HOME/.dtach}"
# Strip a trailing slash so the socket paths built below match the ones wtd measures with
# filepath.Join, which cleans. Without this, `WT_DIR=/a/b/` makes every path here one byte
# longer than the server thinks it is, and the two disagree about the 107-byte ceiling.
[[ "$DIR" != "/" ]] && DIR="${DIR%/}"
mkdir -p "$DIR"

# WT=1 lets a login shell detect it's inside a wt/dtach web session (e.g. to skip
# auto-launching tmux/screen). See docs/bashrc-snippet.sh.
export WT=1

# dtach flags: -z passes Ctrl-Z through to the app; -r winch redraws on attach.
DFLAGS=(-z -r winch)

# Optional name -> project path shortcuts, loaded from a file (one "name /path" per
# line; blank lines and #comments ignored). Empty if the file is absent.
declare -A PROJ=()
PROJ_FILE="${WT_PROJECTS:-$HOME/.config/wt/projects}"
if [[ -r "$PROJ_FILE" ]]; then
  while read -r _name _path; do
    [[ -z "$_name" || "$_name" == '#'* ]] && continue
    PROJ["$_name"]="$_path"
  done < "$PROJ_FILE"
fi

# Longest socket path connect(2) can name. Over this, dtach still *binds* happily and the
# result is worse than an error: the session exists, nothing can ever attach to it, and no
# later probe can tell it from a stale socket. POST /api/v1/sessions refuses such a name up
# front; the deep-link path below hands $1 straight to dtach, so it has to refuse it too.
MAX_SOCK_PATH=107

# LC_ALL=C because ${#var} counts characters while the kernel's limit counts bytes — a name
# with any non-ASCII in it would otherwise measure short and slip past the check.
sock_fits() { local LC_ALL=C; (( ${#1} <= MAX_SOCK_PATH )); }

# --- direct-session shortcut ---------------------------------------------
# `wt <name>` attaches straight to that dtach session, skipping the menu. Same
# socket convention and dtach invocation as the menu paths. Reject path tricks,
# and names too long to build a reachable socket from.
if [ -n "${1:-}" ]; then
  case "$1" in
    */*|*..*) : ;;                       # contains / or .. -> ignore arg, show picker
    *)
      # Falling through to the picker rather than erroring, exactly as the case above does:
      # a client that deep-links an unusable name gets the menu, never a dead session.
      if sock_fits "$DIR/$1.sock"; then
        d="${PROJ[$1]:-$HOME}"; [[ -d "$d" ]] || d="$HOME"
        exec dtach -A "$DIR/$1.sock" "${DFLAGS[@]}" bash -c "cd ${d@Q}; exec bash"
      fi
      ;;
  esac
fi

sessions() {
  local f
  for f in "$DIR"/*.sock; do [[ -S "$f" ]] || continue; basename "$f" .sock; done
}

# dtach returns here when the client detaches (Ctrl-\) or the tab closes; the
# menu loop then redraws.
menu() {
  local choice nm d i line
  while :; do
    mapfile -t SESS < <(sessions)
    printf '\n  terminals @ %s\n\n' "$(hostname -s)"
    if ((${#SESS[@]})); then
      i=1
      for line in "${SESS[@]}"; do printf '   %2d) %s\n' "$i" "$line"; ((i++)); done
    else
      printf '   (no active sessions)\n'
    fi
    printf '\n    n) new     c) cancel to shell     d) disconnect\n\n   > '
    read -r choice || { echo; return 0; }
    case "$choice" in
      '')  ;;                                    # empty -> redraw
      n|N)
        if ((${#PROJ[@]})); then
          printf '   name (shortcuts: %s): ' "${!PROJ[*]}"
        else
          printf '   name: '
        fi
        read -r nm || continue
        [[ -z "$nm" ]] && continue
        d="${PROJ[$nm]:-$HOME}"; [[ -d "$d" ]] || d="$HOME"
        dtach -A "$DIR/$nm.sock" "${DFLAGS[@]}" bash -c "cd ${d@Q}; exec bash"
        ;;
      c|C) exec bash ;;                          # ephemeral shell (WT=1 -> no menu recursion)
      d|D) exit 0 ;;                             # exit wt -> server closes just this connection
      *)
        if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice>=1 && choice<=${#SESS[@]})); then
          dtach -a "$DIR/${SESS[choice-1]}.sock" "${DFLAGS[@]}"
        else
          printf '   ? unknown choice\n'
        fi
        ;;
    esac
  done
}

menu
