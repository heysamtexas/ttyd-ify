#!/usr/bin/env bash
# wt-web-serve — resolve the bind address from config and exec wtd, the Go web terminal.
#
# This is the wtd counterpart to bin/wt-serve. Both exist during the migration: ttyd on
# WT_PORT, wtd on WT_WEB_PORT, so wtd can be exercised from a real config and a real phone
# before it takes over the main port. Retiring ttyd means deleting wt-serve and moving wtd
# to WT_PORT — nothing else.
#
# Same contract as wt-serve: one-shot launcher, so full set -euo pipefail. Never binds a
# wildcard; see bin/wt-bind.sh.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The helper lives beside this script both in a checkout and once installed, so one path
# covers both. Fail loudly if it is missing rather than silently losing bind resolution —
# a partial install must not produce a running server bound somewhere unintended.
# shellcheck source=bin/wt-bind.sh
if ! . "$HERE/wt-bind.sh"; then
  echo "wt-web-serve: cannot source $HERE/wt-bind.sh (bind resolution helper)" >&2
  exit 1
fi

CONFIG="${WT_CONFIG:-/etc/ttyd-ify/config}"
# shellcheck source=/dev/null
[ -r "$CONFIG" ] && . "$CONFIG"

: "${WT_BIND:=localhost}"     # tailscale | localhost | <iface> | <literal-ip>
: "${WT_WEB_PORT:=7683}"      # wtd's port; distinct from WT_PORT (ttyd) during migration.
                              # 7683 not 7682: CLAUDE.md documents 7682 for scratch tests,
                              # and a default that collides with the docs wastes an afternoon.
: "${WT_PICKER:=/usr/local/bin/wt}"
: "${WT_WEB_BIN:=/usr/local/bin/wtd}"
: "${WT_PROJECTS:=}"
: "${WT_AUTH:=}"
: "${WT_TTYD_ARGS:=}"

# Fail closed on settings wtd cannot honor. Both of these are security-relevant, and
# silently ignoring either would *remove* a control the operator deliberately configured:
#
#   WT_AUTH      — ttyd's basic auth. wtd does not implement it, so proceeding would serve
#                  an unauthenticated shell to someone who asked for a password.
#   WT_TTYD_ARGS — raw ttyd flags. Could contain -c (credentials) or -R (read-only); wtd
#                  would ignore them and serve a writable, unauthenticated terminal.
#
# Refusing to start is the safe failure: the ttyd unit is still there during migration, so
# nobody is locked out by this.
if [ -n "$WT_AUTH" ]; then
  echo "wt-web-serve: WT_AUTH is set in $CONFIG, but wtd does not implement basic auth." >&2
  echo "              Refusing to start rather than silently serving an unauthenticated shell." >&2
  echo "              Keep using ttyd (wt.service) for this host, or clear WT_AUTH deliberately." >&2
  exit 1
fi
if [ -n "$WT_TTYD_ARGS" ]; then
  echo "wt-web-serve: WT_TTYD_ARGS is set in $CONFIG ('$WT_TTYD_ARGS'), but those are ttyd" >&2
  echo "              flags and wtd would ignore them — including any that restrict access" >&2
  echo "              such as -c or -R. Refusing to start; clear it to run wtd." >&2
  exit 1
fi

# wtd runs the picker as a child, so anything bin/wt reads must be exported — sourcing the
# config only creates shell variables. This is exactly how WT_PROJECTS was inert for the
# ttyd path until it got an explicit export; see CLAUDE.md.
[ -n "$WT_PROJECTS" ] && export WT_PROJECTS

# `|| BIND_IP=""` is load-bearing under `set -euo pipefail`: resolve_ip's tailscale branch
# pipes into head, so a down tailscaled makes the pipeline non-zero and set -e would kill
# the script at this assignment — before the diagnostic below ever prints. The exit code
# would be right and the journal would be empty, which is the worst combination for anyone
# (or any agent) trying to work out why the service won't start.
BIND_IP="$(resolve_ip "$WT_BIND")" || BIND_IP=""
if [ -z "$BIND_IP" ]; then
  echo "wt-web-serve: could not resolve WT_BIND='$WT_BIND' to an address" >&2
  echo "              (if WT_BIND=tailscale, is tailscaled up? try 'tailscale ip -4')" >&2
  exit 1
fi

echo "wt-web-serve: wtd on ${BIND_IP}:${WT_WEB_PORT} (bind=${WT_BIND}, picker=${WT_PICKER})" >&2
exec "$WT_WEB_BIN" -listen "${BIND_IP}:${WT_WEB_PORT}" -start-command "$WT_PICKER"
