#!/usr/bin/env bash
# wt-narrate — turn the end of an agent's turn into one or two sentences worth speaking.
#
# A Claude Code hook. It is what makes /api/v1/sessions/{name}/narration return anything: wtd
# serves the file this writes and does not make it. See cmd/wtd/narration.go and #112.
#
# Install it yourself — the installer deliberately does not. Hooks live in the service user's
# ~/.claude/settings.json, which is their Claude configuration and not ours to edit, the same
# reason docs/bashrc-snippet.sh is a snippet you paste rather than a file we drop in a shell rc:
#
#     "hooks": {
#       "Stop":         [{"hooks": [{"type": "command", "command": "wt-narrate waiting"}]}],
#       "Notification": [{"hooks": [{"type": "command", "command": "wt-narrate attention"}]}]
#     }
#
# For spoken audio rather than the browser's speech engine, install piper and one voice, then set
# WT_NARRATE_VOICE in /etc/ttyd-ify/config. wt-serve exports it, wtd inherits it, and every session
# it creates passes it to this hook:
#
#     uv tool install piper-tts
#     python -m piper.download_voices --download-dir ~/.local/share/piper-voices en_US-ryan-high
#     # /etc/ttyd-ify/config:
#     WT_NARRATE_VOICE=/home/<you>/.local/share/piper-voices/en_US-ryan-high.onnx
#
# Sessions that already exist do not get it -- a dtach master captures its environment once. Make
# a new session after changing this.
#
# Stop and Notification, and no others, because those are the two events worth hearing about: a
# turn that finished and needs you, and a turn blocked on you right now. They are the same two
# events that already drive `waiting` and `attention` in api/ws-protocol.md §6a.
#
# ## Why the summary is made here and not in the server
#
# Latency. A model call here was measured at 16-37 seconds, wall clock, varying with nothing this
# script controls. That is affordable only because it runs *after* the turn ended: nobody is
# waiting, and by the time anyone asks, the answer is on disk. The same work inside a request
# would put half a minute in front of a person in a car.
#
# The exception is being blocked, where the delay is not free — you want to hear "it needs you"
# now, not once you have driven another mile. Claude Code's Notification payload already carries a
# written-out sentence ("Claude needs your permission to use Bash"), so an `attention` event skips
# the model entirely and uses it. Instant, and more accurate than a summary of it would be.
#
# The rest follows from that: wtd needs no HTTP client, no model dependency, and no API key
# anywhere near /etc/ttyd-ify/config, and this script uses whatever auth the box's own Claude
# install already has.
#
# ## Why the transcript and not the terminal
#
# The obvious input is the session's recent output, and it is the wrong one. Terminal output is
# raw bytes with cursor addressing in it, and an agent that redraws its own interface produces a
# repaint rather than a paragraph — a summary of it is a summary of a screen. The transcript is
# already structured: the prompt, the tool calls, and the closing message, with a turn boundary
# at each real user prompt. Claude Code hands us its path, so there is nothing to guess.
#
# ## Audio, and why it is optional
#
# The page can speak the text with the browser's own speech engine, and that engine is bad enough
# that nobody wants it in a car. It also stops when an iPhone locks, which rules out the actual
# use case. A real audio file fixes both: it sounds like a person, and iOS keeps playing media
# with the screen off.
#
# So if WT_NARRATE_VOICE names a piper voice model, this renders one next to the JSON. If it does
# not, or piper is missing, the JSON ships alone and the page falls back to speech synthesis. That
# is a deliberate degradation and not a half-finished feature: this repo installs a launcher and an
# installer with no build step, and a text-to-speech stack is not something install.sh should be
# dragging onto a box.
#
# WAV, uncompressed, no encoder. About 550 KB for fifteen seconds against 100 KB as MP3 -- which
# over a tailnet is the difference between one second and one second, and browsers play WAV
# natively. An MP3 step would mean depending on ffmpeg, or an optional branch that only one box
# ever runs. Neither is worth 450 KB.
#
# Two states are silence rather than failure, and both exit 0:
#   - WT_SESSION unset: not a wtd session, so there is nothing this could be about (#111).
#   - WT_NARRATION_DIR unset: wtd has no -state-dir, so narration is off for this deployment.
#
# A hook that fails noisily interrupts the agent it is reporting on, so every other failure is
# also non-fatal: it logs to stderr and leaves the previous summary alone. A stale summary is
# better than a crashed turn, and the endpoint's `at` field is what stops a client re-speaking it.
#
# **This script detaches from the hook and returns immediately.** Claude Code waits for a Stop
# hook, so it has to -- see the setsid below. Everything after that point runs with nobody
# watching, which is why failures are logged to a file instead of stderr.
#
# **It also calls `claude`, which runs Stop hooks, which is this script.** That recursion is not
# theoretical: it happened on the first real install and reached dozens of concurrent paid API
# calls in about two minutes. The nested call is fenced twice at the call site -- read that comment
# before changing how the model is invoked.
set -uo pipefail

readonly EVENT="${1:-waiting}"

# Silence, not failure. See the header.
[ -n "${WT_SESSION:-}" ] || exit 0
[ -n "${WT_NARRATION_DIR:-}" ] || exit 0

# When the event happened, stamped NOW -- before the model call, not after it.
#
# This is load-bearing and the obvious placement is wrong. `at` is the client's deduplication key,
# so it has to order EVENTS, and stamping it after the model returns orders WRITES instead. Those
# disagree by the length of a model call, and the disagreement inverts the two events that matter:
#
#   12:00:00  turn ends, Stop hook starts summarising (~25s)
#   12:00:10  agent asks permission; Notification hook writes needsYou:true instantly
#   12:00:25  Stop hook finishes and overwrites it -- a summary of the PREVIOUS turn,
#             needsYou:false, carrying the newer timestamp
#
# The blocked state is erased and replaced by something staler that looks fresher, and no client
# can detect it, because the only thing a client has to order by is the field that lied. You hear
# "I refactored the parser" while your agent sits waiting for an answer.
#
# Entry-time stamping fixes the ordering; the guard before the install fixes the overwrite.
#
# Milliseconds because seconds are not enough resolution: the Notification path answers in ~30ms,
# so an attention and a waiting in the same second produce an identical `at`, and a client
# deduplicating on it drops one of them silently. The one it drops is whichever arrives second,
# which is the attention.
AT="${WT_NARRATE_AT:-$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)}"
readonly AT

warn() { printf 'wt-narrate: %s\n' "$*" >&2; }

# The hook payload arrives on stdin. `transcript_path` is the whole reason this is a hook and not
# a timer: it names the exact file for the session we are in, so nothing has to map a pid to a
# project directory or guess at the newest file in one.
HOOK_JSON="$(cat)" || HOOK_JSON=""

# Detach, and this is not an optimisation -- it is the difference between usable and intolerable.
#
# **Claude Code waits for a Stop hook to finish before the turn ends.** Measured: a `claude -p`
# that answers in 3.6s takes 15.4s with a 12-second Stop hook attached. So a hook that calls a
# model in the foreground adds its own latency to the end of every single turn, in every project
# on the box, whether or not anyone is listening to the result. The whole premise of doing this
# work at turn end is that nobody is waiting for it; running it in the foreground makes everybody
# wait for it.
#
# setsid, not just `&`: a background child still sits in the hook's process group, and something
# that reaps the group takes the summary with it. A new session survives the parent exiting.
#
# WT_NARRATE_AT carries the entry-time stamp across the fork. Re-stamping in the child would undo
# the fix documented above -- the child finishes when the model finishes, which is the write time
# we deliberately stopped using.
#
# Diagnostics go to a file rather than /dev/null. A detached process has nowhere to complain to,
# and "narration is silent" is otherwise unanswerable. sweepNarration leaves this file alone: it
# recognizes only *.json and partial writes.
if [ -z "${WT_NARRATE_CHILD:-}" ]; then
  WT_NARRATE_CHILD=1 WT_NARRATE_AT="$AT" \
    setsid bash "$0" "$EVENT" <<<"$HOOK_JSON" \
    >>"$WT_NARRATION_DIR/wt-narrate.log" 2>&1 &
  exit 0
fi

for tool in jq claude; do
  command -v "$tool" >/dev/null 2>&1 || { warn "$tool is not installed; no summary written"; exit 0; }
done

# The blocked case, taken straight from the hook payload. Claude Code writes `message` as a
# finished sentence naming what it wants, which is already better spoken material than a model's
# summary of it -- and it costs nothing, which is the point: this is the one event where the
# listener is waiting.
#
# Guarded on the field being there rather than on a belief about the payload schema, so a release
# that stops sending it degrades to the model path instead of going silent.
NOTICE=""
if [ "$EVENT" = attention ]; then
  NOTICE="$(printf '%s' "$HOOK_JSON" | jq -r '.message // empty' 2>/dev/null)" || NOTICE=""
fi

TRANSCRIPT="$(printf '%s' "$HOOK_JSON" | jq -r '.transcript_path // empty' 2>/dev/null)" || TRANSCRIPT=""
if [ -z "$NOTICE" ] && { [ -z "$TRANSCRIPT" ] || [ ! -r "$TRANSCRIPT" ]; }; then
  warn "no readable transcript_path on stdin; no summary written"
  exit 0
fi

# A turn is bounded by real user prompts, so a window of recent entries is enough and a whole
# multi-megabyte transcript is not. A prompt older than the window degrades to "no prompt
# captured", which loses context but still yields the part that matters — what the agent said last.
readonly TAIL_LINES=600

# One jq pass produces the three things a summary is made of: what was asked, what was done, and
# what was said at the end. A user entry whose content is a string is a real prompt; one holding
# tool_result blocks is the transcript's record of a tool call coming back, and is not a turn
# boundary. Both shapes exist and confusing them puts the boundary in the wrong place.
BRIEF=""
if [ -z "$NOTICE" ]; then
BRIEF="$(
  tail -n "$TAIL_LINES" "$TRANSCRIPT" 2>/dev/null | jq -s -r '
    [ .[] | select(type == "object") | select(.type == "user" or .type == "assistant") ] as $all
    | [ $all
        | to_entries[]
        | select(.value.type == "user")
        | select(
            .value.message.content
            | if type == "string" then (. | length) > 0
              else (type == "array" and any(.[]; .type == "text"))
              end
          )
        | .key
      ] as $starts
    | (if ($starts | length) > 0 then $all[($starts | last):] else $all end) as $turn
    | {
        prompt: (
          $turn[0]
          | if .type == "user" then
              (.message.content
               | if type == "string" then .
                 else ([.[] | select(.type == "text") | .text] | join(" "))
                 end)
            else "" end
        ),
        # Counts, not names. Feeding tool names in guarantees they come back out, and some of
        # them cannot be said at all -- an MCP tool is called
        # `mcp__claude_ai_Slack__slack_send_message`. So the brief says how much happened and
        # leaves what happened to the closing message, which is prose already.
        tools: ([ $turn[] | select(.type == "assistant") | .message.content[]?
                  | select(.type == "tool_use") ] | length),
        said: (
          [ $turn[] | select(.type == "assistant") | .message.content[]?
            | select(.type == "text") | .text ]
          | last // ""
        )
      }
    # An empty `said` means the turn has no closing message to summarise -- a hook that fired
    # before the text was flushed, or a turn that ended in a tool call. Emitting nothing here
    # makes the caller bail. Sending it anyway costs a paid call whose only possible answer is the
    # model asking to be shown the output, which is what happened the first time this ran for real.
    | if (.said | length) == 0 then empty else
        "ASKED: \(.prompt[0:400])\n\nSTEPS TAKEN: \(.tools)\n\nSAID:\n\(.said[0:1800])"
      end
  ' 2>/dev/null
)" || BRIEF=""

if [ -z "$BRIEF" ]; then
  warn "no closing message in the last turn of $TRANSCRIPT; nothing to summarise"
  exit 0
fi
fi

# The instructions. This is the part that will change the most, so it lives in one place.
#
# Two lines of plain text rather than JSON, deliberately: a model that emits slightly wrong JSON
# would fail after the expensive part, and jq below can build a correct document from plain text
# far more reliably than a model can be talked into escaping one. The shell never has to quote
# anything into JSON by hand.
#
# The rules are about the ear. A speech engine says "hash one eight seven" for #187 and recites a
# URL character by character, so identifiers become words and links are dropped rather than read.
read -r -d '' INSTRUCTIONS <<'PROMPT' || true
You rewrite an AI coding agent's last turn into something a person can HEAR while driving.

Write exactly two lines, in this format, and nothing else:

HEADLINE: <one sentence, at most 18 words>
DETAIL: <at most two sentences, each at most 18 words>

Rules, all of them about being heard rather than read:

- Plain spoken English. Short active sentences. Present or simple past tense.
- Say identifiers as words: "issue 187", never "#187" or "hash one eight seven".
- Never write a token a listener would hear spelled out. ".xlsb" becomes "dot x l s b";
  a commit hash becomes "c e nine one eight two d"; "needsYou" and "WT_DIR" become
  either spelling or nonsense. Say the thing in words instead: "an Excel file", "that
  commit", "the session name setting".
- Name a file by what it IS, not by its filename: "the readme", "the install script",
  "the spec". Use a filename only when saying it aloud is natural.
- Never include a URL, a file path, a code fence, backticks, or any markdown.
- When you list things, repeat the noun: "issue 185, issue 186" -- not "185, 186 and
  187", where the ear loses what the numbers are.
- Say numbers the way a person says them.
- No preamble, no "the agent", no meta-commentary about the summary itself.
- If the turn ended by asking the user something, the HEADLINE must say what is being
  asked. That is the most useful thing you can say.
- If nothing meaningful happened, say so in one short sentence.
- Brevity beats completeness. Someone is driving. Leave things out.

The turn follows. STEPS TAKEN is a count of tool calls, so say roughly how much work
happened ("a few commands", "a lot of edits") and never invent what the tools were.
PROMPT

# --strict-mcp-config with an empty config is worth roughly a second of startup: without it the
# CLI connects every configured MCP server before answering a prompt that cannot use any of them.
HEADLINE=""
DETAIL=""
if [ -n "$NOTICE" ]; then
  # Trimmed to one line: this becomes a JSON string field, and a multi-line notice would be
  # spoken with the newline in it.
  NOTICE="$(printf '%s' "$NOTICE" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g; s/^ //; s/ $//')"

  # An attention event FLAGS the existing summary; it does not replace it. The first version got
  # this wrong and it was the worst thing about the feature in use: the payload's message is
  # sometimes specific ("Claude needs your permission to use Bash") and sometimes vacuous
  # ("Claude is waiting for your input"), and either way it arrived *after* a real summary and
  # overwrote it. So a listener who had a useful sentence waiting got a useless one instead.
  #
  # Keeping the previous headline is what makes it read: "Finished the refactor. Claude needs
  # your permission to use Bash." The headline says what happened, the notice says what it wants,
  # and needsYou below says you have to answer. With no previous summary the notice is all there
  # is, so it becomes the headline on its own.
  PREV_HEADLINE=""
  if [ -f "$WT_NARRATION_DIR/$WT_SESSION.json" ]; then
    PREV_HEADLINE="$(jq -r '.headline // empty' "$WT_NARRATION_DIR/$WT_SESSION.json" 2>/dev/null)" || PREV_HEADLINE=""
  fi
  if [ -n "$PREV_HEADLINE" ]; then
    HEADLINE="$PREV_HEADLINE"
    DETAIL="$NOTICE"
  else
    HEADLINE="$NOTICE"
  fi
else
  # Run from a neutral directory. The CLI otherwise loads the session's CLAUDE.md and rule files
  # into a prompt that cannot use any of them, which is about a second of nothing per turn.
  # stderr is kept, not discarded. This runs detached with nobody watching, so a swallowed error
  # message turns every failure into the same unanswerable "no summary appeared" -- which is
  # exactly what happened the first time this ran for real.
  # TWO guards against recursion, and both are load-bearing. Learned the expensive way: this hook
  # calls `claude`, and `claude` runs the user's Stop hook when it finishes -- which is this hook.
  # So one turn spawned a narrator, whose model call spawned a narrator, whose model call spawned a
  # narrator. It reached dozens of concurrent processes in a couple of minutes, each one a paid API
  # call, and it will not stop on its own.
  #
  #   --settings '{"hooks":{}}'   the nested call runs no hooks at all.
  #   env -u WT_SESSION           and if it somehow does, the narrator it runs exits at the
  #                               silence check, because it is not in a session.
  #
  # Either alone is sufficient. Both, because the failure mode is unbounded spend rather than a
  # wrong answer, and because the first depends on a CLI flag's behaviour and the second does not.
  SPOKEN="$(
    cd /tmp && printf '%s\n\n%s\n' "$INSTRUCTIONS" "$BRIEF" \
      | env -u WT_SESSION -u WT_NARRATION_DIR -u WT_NARRATE_CHILD -u WT_NARRATE_AT \
        timeout 90 claude -p \
          --model claude-haiku-4-5-20251001 \
          --strict-mcp-config \
          --mcp-config '{"mcpServers":{}}' \
          --settings '{"hooks":{}}' 2>&1
  )" || SPOKEN=""

  HEADLINE="$(printf '%s\n' "$SPOKEN" | sed -n 's/^[[:space:]]*HEADLINE:[[:space:]]*//p' | head -1)"
  DETAIL="$(printf '%s\n' "$SPOKEN" | sed -n 's/^[[:space:]]*DETAIL:[[:space:]]*//p' | head -1)"
fi

if [ -z "$HEADLINE" ]; then
  # Print what did come back. A model that answered in the wrong shape and a CLI that failed
  # outright are different problems, and "no headline" cannot tell them apart.
  warn "no headline for session $WT_SESSION; leaving the previous summary alone. Reply was:"
  printf '%s\n' "$SPOKEN" | head -20 | sed 's/^/wt-narrate:   /' >&2
  exit 0
fi

# needsYou is the only field that authorizes a client to speak without being asked, so it is
# derived from the event rather than from anything the model said. `attention` is Claude Code's
# own signal that it is blocked on a prompt; a finished turn is not an interruption.
NEEDS_YOU=false
[ "$EVENT" = attention ] && NEEDS_YOU=true

# Temp file then rename, so a reader never sees a half-written summary. Same directory, because
# rename is only atomic within a filesystem. umask rather than a chmod, so the file is never
# briefly readable by anyone else.
# No -p, deliberately. wtd creates this directory at startup and refuses to create the operator's
# -state-dir above it (ringstore.go states why: pointing -state-dir somewhere is an assertion about
# that place's privacy). Creating parents here would reintroduce exactly what the server declines to
# do, from a process with fewer reasons to be sure. This only covers the directory being removed
# under a running server.
if [ ! -d "$WT_NARRATION_DIR" ] && ! mkdir -m 0700 "$WT_NARRATION_DIR" 2>/dev/null; then
  warn "cannot create $WT_NARRATION_DIR; no summary written"
  exit 0
fi
TMP="$(umask 077 && mktemp "$WT_NARRATION_DIR/$WT_SESSION.json.tmp.XXXXXX")" || {
  warn "cannot write into $WT_NARRATION_DIR; no summary written"
  exit 0
}
trap 'rm -f "$TMP"' EXIT

# jq builds the document, so every string is escaped correctly no matter what the model said.
if ! jq -n \
  --arg session "$WT_SESSION" \
  --arg event "$EVENT" \
  --arg at "$AT" \
  --arg headline "$HEADLINE" \
  --arg detail "$DETAIL" \
  --argjson needsYou "$NEEDS_YOU" \
  '{session: $session, event: $event, at: $at, headline: $headline,
    detail: $detail, needsYou: $needsYou}' >"$TMP"; then
  warn "could not build the summary document; leaving the previous summary alone"
  exit 0
fi

# Do not install over something newer. The other half of the inversion described at $AT: two hooks
# for one session run as separate processes with wildly different durations, so a slow Stop can
# still be holding a finished document when a fast Notification has already published a later one.
# Entry-time stamping makes that detectable; this is what acts on it.
#
# Compared as epoch milliseconds rather than as strings, because a string comparison across two
# timestamp formats silently gets it backwards -- "…13.500Z" sorts before "…13Z", since "." is
# below "Z". Nothing writes the second form today, and that is exactly the kind of assumption that
# stops being true quietly.
FINAL="$WT_NARRATION_DIR/$WT_SESSION.json"
if [ -f "$FINAL" ]; then
  PREV_AT="$(jq -r '.at // empty' "$FINAL" 2>/dev/null)" || PREV_AT=""
  if [ -n "$PREV_AT" ]; then
    PREV_MS="$(date -d "$PREV_AT" +%s%3N 2>/dev/null)" || PREV_MS=""
    THIS_MS="$(date -d "$AT" +%s%3N 2>/dev/null)" || THIS_MS=""
    if [ -n "$PREV_MS" ] && [ -n "$THIS_MS" ] && [ "$PREV_MS" -gt "$THIS_MS" ]; then
      warn "a newer summary for $WT_SESSION is already published ($PREV_AT); keeping it"
      exit 0
    fi
  fi
fi

mv -f "$TMP" "$FINAL" || {
  warn "could not install the summary for $WT_SESSION"
  exit 0
}
trap - EXIT

# Audio last, on purpose. The text is the product; the audio is a nicer way to deliver it. Render
# it before publishing the JSON and a piper that is missing, broken or slow would cost the summary
# too. This way the worst case is a summary the page reads in its own voice.
[ -n "${WT_NARRATE_VOICE:-}" ] || exit 0
command -v piper >/dev/null 2>&1 || {
  warn "WT_NARRATE_VOICE is set but piper is not installed; text only"
  exit 0
}
[ -r "$WT_NARRATE_VOICE" ] || {
  warn "cannot read voice model $WT_NARRATE_VOICE; text only"
  exit 0
}

# What gets spoken, and it is not the JSON. The headline and the detail are one utterance because
# that is how they are heard -- a gap between them sounds like the end of the message.
SPEECH="$HEADLINE"
[ -n "$DETAIL" ] && SPEECH="$HEADLINE $DETAIL"

AUDIO_TMP="$(umask 077 && mktemp "$WT_NARRATION_DIR/$WT_SESSION.wav.tmp.XXXXXX")" || exit 0
trap 'rm -f "$AUDIO_TMP"' EXIT

# piper writes an onnxruntime PCI-discovery warning on stderr on EVERY run. It is not an error and
# it is not optional, so it is filtered rather than kept: a log that gains half a kilobyte of the
# same warning per turn is a log nobody reads, which defeats the only reason this file exists.
# Anything else piper says is kept. Whether a file arrived is still the test of success.
if ! printf '%s\n' "$SPEECH" | timeout 120 piper -m "$WT_NARRATE_VOICE" -f "$AUDIO_TMP" \
     2> >(grep -v 'onnxruntime' >>"$WT_NARRATION_DIR/wt-narrate.log"); then
  warn "piper failed for $WT_SESSION; text only"
  exit 0
fi
[ -s "$AUDIO_TMP" ] || {
  warn "piper produced no audio for $WT_SESSION; text only"
  exit 0
}

# Published under the same name as the JSON so the server pairs them by name alone, and installed
# by rename so a client polling the endpoint never reads a partial file.
mv -f "$AUDIO_TMP" "$WT_NARRATION_DIR/$WT_SESSION.wav" || {
  warn "could not install the audio for $WT_SESSION"
  exit 0
}
trap - EXIT
