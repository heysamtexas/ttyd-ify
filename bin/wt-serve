#!/usr/bin/env bash
# wt-serve — resolve the bind address from config and exec wtd, the Go web terminal.
#
# This is what wt.service runs. It is the only server launcher: ttyd is retired (#23), so
# wtd owns WT_PORT and there is one listener on the box. wtd replaced ttyd, not dtach —
# bin/wt is still the start command and sessions still live as dtach sockets.
#
# One-shot launcher, so full set -euo pipefail (bin/wt has a different contract and
# deliberately omits -e). Never binds a wildcard; see bin/wt-bind.sh.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The helper lives beside this script both in a checkout and once installed, so one path
# covers both. Fail loudly if it is missing rather than silently losing bind resolution —
# a partial install must not produce a running server bound somewhere unintended.
# shellcheck source=bin/wt-bind.sh
if ! . "$HERE/wt-bind.sh"; then
  echo "wt-serve: cannot source $HERE/wt-bind.sh (bind resolution helper)" >&2
  exit 1
fi

CONFIG="${WT_CONFIG:-/etc/ttyd-ify/config}"

# Missing and unreadable are different states and only one of them is legitimate.
#
# Missing is fine: a fresh box with no config, or WT_CONFIG pointed at a scratch file not
# written yet. The `: "${WT_X:=default}"` fallbacks below are the answer for it, and
# WT_BIND=localhost is a safe one.
#
# Present-but-unreadable is a permissions bug, and every value the operator set is being
# ignored — including WT_BIND, which this project names as *the* access control. The usual
# cause is the service user changing without a re-install, since install.sh writes the config
# 0640 root:$WT_USER. errexit does not catch it: a failing left-hand side of an && list is a
# tested condition, not a failed command, so `[ -r … ] && . …` silently skips and the startup
# line below then prints a bind address nobody configured. The fail-open has to be explicit.
if [ -e "$CONFIG" ] && [ ! -r "$CONFIG" ]; then
  echo "wt-serve: $CONFIG exists but is not readable by $(id -un), so every setting in it" >&2
  echo "          is being ignored — including WT_BIND, which is what limits who can reach" >&2
  echo "          this shell. Refusing to start on defaults you did not configure." >&2
  echo "          Fix the mode (install.sh writes 0640 root:\$WT_USER), or re-run the" >&2
  echo "          install if the service user changed:  make install WT_USER=$(id -un)" >&2
  exit 1
fi
# shellcheck source=/dev/null
[ -r "$CONFIG" ] && . "$CONFIG"

: "${WT_BIND:=localhost}"     # tailscale | localhost | <iface> | <literal-ip>
: "${WT_PORT:=7681}"          # 7681 is also the iOS client's ServerProfile.port default, so
                              # every existing profile reaches wtd without being edited
: "${WT_PICKER:=}"           # retired: wtd attaches to dtach itself. See the warning below.
: "${WT_WEB_BIN:=/usr/local/bin/wtd}"
: "${WT_DIR:=}"              # session socket directory; empty means wtd's default (~/.dtach)
: "${WT_PROJECTS:=}"
: "${WT_AUTH:=}"
: "${WT_TTYD_ARGS:=}"
: "${WT_REPLAY_BYTES:=}"      # bytes of output replayed on attach, per session; 0 disables

# WT_WEB_PORT was wtd's own port while ttyd owned WT_PORT; #23 retired it. Honouring it as an
# alias would mean no box ever migrated, because the shipped example set it to 7683 verbatim.
# Warn rather than refuse: a stale key must not keep a box off the network, and a port is not
# an access control — WT_BIND is.
if [ -n "${WT_WEB_PORT:-}" ]; then
  echo "wt-serve: WT_WEB_PORT=$WT_WEB_PORT in $CONFIG is retired and ignored." >&2
  echo "          WT_PORT ($WT_PORT) is the port. Delete the line; if you meant to move the" >&2
  echo "          port, set WT_PORT instead." >&2
fi

# Fail closed on the two settings wtd cannot honor. Both are access controls — basic auth, and
# ttyd flags that may include -c or -R — so ignoring either would silently remove a restriction
# the operator configured. Full rationale in api/compatibility.md section 4.
#
# install.sh makes the same refusals before it writes anything, which is the intended place to
# find out; reaching these lines means an install was bypassed or the config changed since.
if [ -n "$WT_AUTH" ]; then
  echo "wt-serve: WT_AUTH is set in $CONFIG, but wtd does not implement basic auth." >&2
  echo "          Refusing to start rather than silently serving an unauthenticated shell." >&2
  echo "          Clear it and control access at the network layer (tailnet ACL, source-IP" >&2
  echo "          allowlist, SSH tunnel). Basic auth as a wtd feature is tracked in #27." >&2
  exit 1
fi
if [ -n "$WT_TTYD_ARGS" ]; then
  echo "wt-serve: WT_TTYD_ARGS is set in $CONFIG ('$WT_TTYD_ARGS'), but ttyd is retired —" >&2
  echo "          there is no server left for those flags to apply to, and wtd would ignore" >&2
  echo "          them, including any that restrict access such as -c or -R. Refusing to" >&2
  echo "          start; clear the line to run wtd." >&2
  exit 1
fi

# WT_PICKER named the start command while bin/wt was it; wtd now attaches to dtach itself, so
# there is nothing left for the key to point at. Warn rather than refuse, following WT_WEB_PORT:
# a stale key must not keep a box off the network, and a picker path is not an access control.
#
# No config on this box sets it any more — the only one that did had the line removed by hand
# when #49 landed. So this path is dead on the one install that exists, and it is kept for the
# reason it was written rather than for a box it still fires on: install.sh never clobbers a
# config, so a key left in one has to be visibly ignored rather than honoured as an alias for
# -start-command, which is how #23 nearly left a box un-migrated.
if [ -n "$WT_PICKER" ]; then
  echo "wt-serve: WT_PICKER=$WT_PICKER in $CONFIG is retired and ignored." >&2
  echo "          wtd attaches to dtach sessions itself. Delete the line." >&2
  echo "          To run an external start command anyway, pass -start-command to wtd." >&2
fi

# Passed as flags, not exported, and that is the point: sourcing the config creates shell
# variables, so a key read from the *environment* by a child silently never arrives. WT_PROJECTS
# was inert that way for as long as it was documented, and WT_DIR still was until #28. A flag
# either arrives or is visibly missing from the process's command line.
#
# Only passed when set, so wtd's own defaults stay the single source of both paths.
DIR_ARGS=()
[ -n "$WT_DIR" ] && DIR_ARGS+=(-session-dir "$WT_DIR")
[ -n "$WT_PROJECTS" ] && DIR_ARGS+=(-projects-file "$WT_PROJECTS")

# Still exported as well. The consumer this was written for was bin/wt over SSH, and that file
# is gone (deleted with the picker in #49) — but wtd spawns every terminal with
# `append(os.Environ(), …)` (cmd/wtd/attach.go), so these reach the interactive shell inside a
# web session. That is what lets a human run `dtach` by hand against the same directory the
# server serves, instead of guessing at it, which is the disagreement this project exists to
# avoid. Cheap to keep, and nothing else would tell that human where to look.
[ -n "$WT_DIR" ] && export WT_DIR
[ -n "$WT_PROJECTS" ] && export WT_PROJECTS

# `|| BIND_IP=""` is load-bearing under `set -euo pipefail`: resolve_ip's tailscale branch
# pipes into head, so a down tailscaled makes the pipeline non-zero and set -e would kill
# the script at this assignment — before the diagnostic below ever prints. The exit code
# would be right and the journal would be empty, which is the worst combination for anyone
# (or any agent) trying to work out why the service won't start.
BIND_IP="$(resolve_ip "$WT_BIND")" || BIND_IP=""
if [ -z "$BIND_IP" ]; then
  echo "wt-serve: could not resolve WT_BIND='$WT_BIND' to an address" >&2
  echo "          (if WT_BIND=tailscale, is tailscaled up? try 'tailscale ip -4')" >&2
  exit 1
fi

# Only passed when set, so wtd's own default stays the single source of that number rather
# than being duplicated here. An unset key and a key set to the default must behave
# identically; an empty string is not a valid int flag, hence the guard rather than always
# passing it.
REPLAY_ARGS=()
if [ -n "$WT_REPLAY_BYTES" ]; then
  REPLAY_ARGS=(-replay-bytes "$WT_REPLAY_BYTES")
fi

# Not a WT_* key: $RUNTIME_DIRECTORY is systemd's, set by RuntimeDirectory=wt in wt.service,
# and it is where wtd saves each session's replay buffer across restarts (#92). A dev run has
# no such variable, so persistence is simply off outside the unit — nothing to configure and
# nothing to mis-set. The directory is 0700 tmpfs; see the unit file for why that matters.
STATE_ARGS=()
if [ -n "${RUNTIME_DIRECTORY:-}" ]; then
  STATE_ARGS=(-state-dir "$RUNTIME_DIRECTORY")
fi

# This line is the contract `journalctl -u wt.service | grep 'wt-serve: wtd on'` depends on,
# and it is how anyone (or any agent) finds out where the server actually bound. See
# api/compatibility.md section 6.
echo "wt-serve: wtd on ${BIND_IP}:${WT_PORT} (bind=${WT_BIND}, terminals=dtach)" >&2
exec "$WT_WEB_BIN" -listen "${BIND_IP}:${WT_PORT}" "${DIR_ARGS[@]}" "${REPLAY_ARGS[@]}" "${STATE_ARGS[@]}"
